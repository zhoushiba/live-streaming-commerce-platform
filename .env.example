# ==========================================================================
# 直播电商平台 · 环境变量样例（复制为 .env 后按需修改）
# 复制：cp .env.example .env（PowerShell: Copy-Item .env.example .env）
# 注意：.env 已在 .gitignore 中，绝不要把真实密钥提交到仓库
# ==========================================================================

# ---------- 运行时 ----------
NODE_ENV=development
PORT=3000
# 所有 REST 接口统一前缀
API_PREFIX=api
# 前端地址（用于拼接 Mock 支付页跳转地址、CORS 白名单）
PUBLIC_WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 数据库 ----------
# sqlite：本地开发 / 自动化测试（零外部依赖）
# mysql ：生产形态，配合 db/schema.mysql.sql
DB_CLIENT=sqlite
DB_FILENAME=./storage/live.db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=live_app
DB_PASSWORD=live_app_pwd
DB_NAME=live_commerce
DB_POOL_MIN=2
DB_POOL_MAX=10
# 启动时自动建表（幂等）；生产建议关闭，改用 db/schema.mysql.sql 手工执行
DB_AUTO_MIGRATE=true
DB_LOG_SQL=false

# ---------- JWT ----------
# 生产环境必须替换为 32 字节以上随机串：openssl rand -hex 32
JWT_ACCESS_SECRET=dev_access_secret_please_change_me_32bytes
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=dev_refresh_secret_please_change_me_32bytes
JWT_REFRESH_TTL=604800
JWT_ISSUER=live-commerce

# ---------- 登录风控 ----------
LOGIN_MAX_FAIL=5
LOGIN_LOCK_MINUTES=15

# ---------- 缓存（Redis 适配层；未安装 Redis 时用内存实现） ----------
# memory：进程内 Map（默认，零依赖）
# redis ：ioredis 真实连接，docker-compose 里已编排
CACHE_DRIVER=memory
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=live:

# ---------- 直播流 ----------
# 切片静态目录，下面按 roomId 分子目录存放 index.m3u8 / *.ts / live.flv
STREAM_DIR=./storage/streams
# 播放地址签名（防盗链）密钥与有效期
STREAM_TOKEN_SECRET=dev_stream_secret_please_change_me_32b
STREAM_TOKEN_TTL=7200
# 是否允许未购买用户获取付费房间的播放地址（演示可设 true）
ALLOW_PREVIEW_PAID_ROOM=false

# ---------- 弹幕 ----------
DANMAKU_RATE_LIMIT=5
DANMAKU_RATE_WINDOW=5
DANMAKU_MAX_LENGTH=60
DANMAKU_HISTORY_SIZE=50

# ---------- 支付 · Mock（本地主演示路径） ----------
MOCK_PAY_SECRET=dev_mock_pay_secret_change_me
MOCK_PAY_TTL_MINUTES=15

# ---------- 支付 · 微信 V3 ----------
# sandbox：无商户号时使用本地自签名证书 + 自动生成的 APIv3 key，
#          报文结构、RSA-SHA256 验签、AES-256-GCM 解密全部真实执行；
# live   ：填入真实商户参数后即可直连 https://api.mch.weixin.qq.com
WECHAT_PAY_MODE=sandbox
WECHAT_APPID=wx_demo_appid
WECHAT_MCHID=1900000000
WECHAT_SERIAL_NO=
WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY_PATH=./storage/sandbox/wechat_apiclient_key.pem
WECHAT_PLATFORM_CERT_PATH=./storage/sandbox/wechat_platform_cert.pem
WECHAT_NOTIFY_URL=http://localhost:3000/api/payments/wechat/notify

# ---------- 支付 · 支付宝 ----------
ALIPAY_MODE=sandbox
ALIPAY_APP_ID=2021000000000000
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_PRIVATE_KEY_PATH=./storage/sandbox/alipay_app_private.pem
ALIPAY_PUBLIC_KEY_PATH=./storage/sandbox/alipay_platform_public.pem
ALIPAY_NOTIFY_URL=http://localhost:3000/api/payments/alipay/notify

# ---------- 定时任务 ----------
# 超时关单扫描间隔（cron 表达式，秒级：每 60 秒）
ORDER_CLOSE_CRON=*/60 * * * * *
# 观看人数落库间隔
VIEWER_FLUSH_CRON=*/30 * * * * *
RECONCILIATION_CRON=0 30 2 * * *

# ---------- 种子账号 ----------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ANCHOR_USERNAME=anchor
SEED_ANCHOR_PASSWORD=Anchor@123456
SEED_VIEWER_USERNAME=viewer
SEED_VIEWER_PASSWORD=Viewer@123456
